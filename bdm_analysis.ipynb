   "source": [
    "df['Date'] = pd.to_datetime(df['Date'], errors='coerce')\n",
    "df['Start_Date'] = pd.to_datetime(df['Start_Date'], errors='coerce')\n",
    "df['End_Date'] = pd.to_datetime(df['End_Date'], errors='coerce')\n",
    "\n",
    "# Remove rows with missing critical values\n",
    "df.dropna(subset=['Date', 'Product_Name', 'Total_Sales_Value'], inplace=True)\n",
    "\n",
    "# Calculate profit & margin\n",
    "df['Profit'] = df['Total_Sales_Value'] - (df['Quantity_Sold'] * df['Cost_Price'])\n",
    "df['Profit_Margin_%'] = (df['Profit'] / df['Total_Sales_Value']) * 100\n",
    "\n",
    "# Extract time features\n",
    "df['Month'] = df['Date'].dt.month_name()\n",
    "df['Weekday'] = df['Date'].dt.day_name()\n",
    "\n",
    "print(\"Data cleaned and new columns added ✅\")\n",
    "display(df.head())"
   ]
  },
